# Bench-specific values. Install without the .example suffix in
# ~/.config/efis/ and keep the deployed file outside version control.
EFIS_PIXHAWK_SERIAL=/dev/serial/by-id/usb-ArduPilot_Pixhawk6X_3F001D000751333439393536-if00
# Dopo il passaggio del Pixhawk alla rete FLIGHT-DATA, il bridge USB resta un
# endpoint locale di manutenzione. Non inoltrare la stessa telemetria anche alla
# Blackbox: due copie indistinguibili sulla porta 14550 non sono ridondanza.
EFIS_MAVLINK_DEST_ARGS=--destination 127.0.0.1:14550
