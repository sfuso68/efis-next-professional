[Unit]
Description=EFIS QGroundControl monitor-only host firewall
Documentation=file:/opt/efis-next/docs/deployment/MAVLINK_OBSERVER_GATEWAY.md
After=nftables.service network-pre.target
Before=network-online.target
Wants=network-pre.target

[Service]
Type=oneshot
ExecStartPre=-/usr/sbin/nft delete table inet efis_qgc_monitor
ExecStart=/usr/sbin/nft --file /etc/efis/qgc-monitor-firewall.nft
ExecStop=/usr/sbin/nft delete table inet efis_qgc_monitor
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
