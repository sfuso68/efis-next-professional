[Unit]
Description=EFIS Next Blackbox normalized DDP broker
Documentation=file:///home/efis/efis-next/docs/deployment/BLACKBOX_BROKER.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blackbox
Group=blackbox
WorkingDirectory=/opt/efis-blackbox
Environment=EFIS_PFD_ADDRESS=192.168.1.45
Environment=EFIS_PFD_DDP_PORT=49002
Environment=EFIS_BLACKBOX_NODE=47
Environment=EFIS_MAVLINK_BIND=0.0.0.0
Environment=EFIS_MAVLINK_PORT=14550
Environment=EFIS_SENSOR_CAN=can_a
EnvironmentFile=-/etc/efis/blackbox-broker.env
ExecStart=/opt/efis-blackbox/bin/efis-blackbox-broker --mavlink-bind ${EFIS_MAVLINK_BIND} --mavlink-port ${EFIS_MAVLINK_PORT} --can-interface ${EFIS_SENSOR_CAN} --display ${EFIS_PFD_ADDRESS} --display-port ${EFIS_PFD_DDP_PORT} --source-node ${EFIS_BLACKBOX_NODE} --records /var/lib/blackbox/flight --rate-hz 20
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/blackbox/flight
RestrictAddressFamilies=AF_INET AF_CAN
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
