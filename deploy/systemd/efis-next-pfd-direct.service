[Unit]
Description=EFIS NEXT PFD (direct DRM/EGLFS)
Documentation=file:///home/pi/efis-next-current/docs/deployment/RPI5_PFD.md
Wants=network-online.target
After=network-online.target lightdm.service fuso-sv3d.service fuso-sv3d-sim.service
Conflicts=lightdm.service fuso-sv3d.service fuso-sv3d-sim.service
StartLimitBurst=5
StartLimitIntervalSec=60
ConditionPathExists=/home/pi/efis-next-current/build-rpi5/efis-pfd-qt

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=video render input
WorkingDirectory=/home/pi/efis-next-current
Environment=HOME=/home/pi
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_KMS_CONFIG=/etc/efis/eglfs-kms.json
Environment=QSG_RENDER_LOOP=threaded
Environment=EFIS_KIOSK=1
Environment=EFIS_DDP_BIND_ADDRESS=0.0.0.0
Environment=EFIS_DDP_LISTEN_PORT=49002
Environment=EFIS_DDP_SOURCE_NODE=47
Environment=EFIS_SIMULATION_ROLE=FALLBACK
Environment=EFIS_TERRAIN_GPU_ROOT=/home/pi/efis-data/terrain/gpu
Environment=EFIS_IMAGERY_TEXTURE_ROOT=/home/pi/efis-data/imagery/active-textures
Environment=EFIS_IMAGERY_ACTIVE_PACKAGE=/home/pi/efis-data/imagery/active-package.json
ExecStartPre=/usr/bin/sleep 1
ExecStart=/home/pi/efis-next-current/build-rpi5/efis-pfd-qt
Restart=always
RestartSec=3
TimeoutStopSec=5
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
