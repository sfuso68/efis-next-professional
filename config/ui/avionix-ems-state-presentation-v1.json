{
  "schema": "avionix.ems-state-presentation.v1",
  "status": "SOFTWARE_REFERENCE_NOT_HARDWARE_ACCEPTANCE",
  "role": "EMS",
  "platform": "RPi4",
  "resolution": [800, 480],
  "states": [
    {"name": "LIVE", "age_ms": 0, "severity": "NORMAL", "show_age": false, "normal_green_allowed": true},
    {"name": "STALE", "age_ms": 600, "severity": "CAUTION", "show_age": true, "normal_green_allowed": false},
    {"name": "DEGRADED", "age_ms": 600, "severity": "CAUTION", "show_age": true, "normal_green_allowed": false},
    {"name": "LOST", "age_ms": 1500, "severity": "WARNING", "show_age": true, "normal_green_allowed": false},
    {"name": "FAIL", "age_ms": 0, "severity": "WARNING", "show_age": false, "normal_green_allowed": false},
    {"name": "SIM", "age_ms": 0, "severity": "SIMULATION", "show_age": false, "normal_green_allowed": true}
  ],
  "presentation": {
    "normal_ranges_hidden_for": ["STALE", "DEGRADED", "LOST", "FAIL"],
    "last_value_policy": "MAY_RETAIN_WITH_EXPLICIT_INVALIDITY",
    "cas_caution_states": ["STALE", "DEGRADED"],
    "cas_warning_states": ["LOST", "FAIL"],
    "derived_functions_blocked_for": ["LOST", "FAIL"],
    "colour_is_not_only_cue": true,
    "sim_always_visible": true,
    "no_control_authority": true
  },
  "golden": {
    "schema": "avionix.ems-state-golden.v1",
    "directory": "tests/golden/ems-states",
    "filename_template": "ems-800x480-{state}.png",
    "platform": "windows",
    "interactive": false
  }
}
