{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avionix-next:evidence-bundle:v1",
  "title": "AVIONIX NEXT evidence bundle V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidence_id", "requirement_ids", "gate", "level", "status", "created_utc", "producer", "environment", "artifacts", "checks", "limitations", "flight_approval"],
  "properties": {
    "schema": {"const": "avionix-next.evidence-bundle.v1"},
    "evidence_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]+-[A-Z0-9]+-[0-9]+$"}},
    "gate": {"enum": ["G0", "G1", "G2", "G3", "G4", "G5", "G6", "G7"]},
    "level": {"enum": ["VERIFIED_SW", "EVIDENCE_HW_HISTORICAL", "VERIFY_HW", "BLOCKED"]},
    "status": {"enum": ["PASS", "FAIL", "INCOMPLETE"]},
    "created_utc": {"type": "string", "format": "date-time"},
    "producer": {"type": "object", "additionalProperties": false, "required": ["tool", "version", "commit"], "properties": {"tool": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}}},
    "environment": {"type": "object", "additionalProperties": false, "required": ["class", "os", "architecture"], "properties": {"class": {"enum": ["CI", "WORKSTATION", "RPI4", "RPI5", "BLACKBOX", "SERVER", "NAS", "HARDWARE_BENCH"]}, "os": {"type": "string", "minLength": 1}, "architecture": {"type": "string", "minLength": 1}, "node": {"type": "string"}}},
    "artifacts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size": {"type": "integer", "minimum": 0}}}},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "status", "evidence"], "properties": {"id": {"type": "string", "minLength": 1}, "status": {"enum": ["PASS", "FAIL", "SKIP"]}, "evidence": {"type": "string", "minLength": 1}}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "flight_approval": {"const": false}
  }
}
