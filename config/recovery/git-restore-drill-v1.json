  "safety_rules": [
    "destination_must_not_exist",
    "never_replace_runtime_or_working_copy",
    "never_delete_source_or_restored_tree",
    "expected_main_must_be_supplied_from_authoritative_GitHub",
    "no_credentials_in_source_url",
    "flight_approval_is_always_false"
  ]
}
